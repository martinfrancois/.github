{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":rebaseStalePrs"
  ],
  "labels": ["dependencies"],
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "statusCheckWhen": {
    "minimumReleaseAge": "never"
  },
  "pinDigests": true,
  "rangeStrategy": "pin",
  "dependencyDashboardApproval": false,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null,
    "schedule": [],
    "updateNotScheduled": true,
    "groupName": null,
    "groupSlug": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The CI workflow runs actionlint with `go run`, which no built-in manager reads.",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "go run (?<depName>github\\.com/rhysd/actionlint)/cmd/actionlint@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Merge eligible non-major updates after checks pass; keep unrelated dependencies separate.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Major updates require human review.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major update"]
    }
  ]
}
